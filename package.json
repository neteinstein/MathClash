{
  "name": "mathclash",
  "private": true,
  "version": "1.0.0",
  "description": "Jogo de matemática para dois jogadores no mesmo ecrã — conquista o tabuleiro com a tua cor!",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@fontsource/fredoka": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
